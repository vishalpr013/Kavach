# ET-AI Backend Environment Variables
# Copy this to .env and fill in your API keys

# Required — Groq is the default provider, used out-of-the-box
DEFAULT_GROQ_API_KEY=your_groq_api_key_here

# Optional — only needed if you want to switch providers
DEFAULT_OPENAI_API_KEY=
DEFAULT_GEMINI_API_KEY=
DEFAULT_CLAUDE_API_KEY=
